# MyLiquid configuration. Copy to .env.local and fill in what you need.

# Claude powers the agent desk. Without a key, every agent runs in deterministic
# "offline" mode, so the whole platform still works.
ANTHROPIC_API_KEY=

# Model used by the agents (default: claude-opus-5).
MYLIQUID_MODEL=claude-opus-5

# Reasoning effort for agent calls: low | medium | high | xhigh | max (default: medium).
MYLIQUID_EFFORT=medium

# Where the SQLite database lives (default: .data/myliquid.db).
MYLIQUID_DB_PATH=.data/myliquid.db

# A hosted libSQL database (Turso) instead of the file. Required on Vercel; see docs/DEPLOY.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Keep a deployment private: every page asks for this password first (a password page that remembers the device
# for 90 days; scripts can send it with HTTP Basic auth, any user name).
MYLIQUID_SITE_PASSWORD=

# AINRA agent identity (https://github.com/JacobJandon/ainra). Paths to the root keys and the root-signed
# registrar directory, as AINRA publishes them. Unset = testbed mode on the bundled TEST-ROOT samples.
AINRA_ROOTS_FILE=
AINRA_DIRECTORY_FILE=
# Or the same JSON in variables, for hosts without files (Vercel):
AINRA_ROOTS_JSON=
AINRA_DIRECTORY_JSON=
# A live AINRA registrar (docs/AINRA-LIVE.md; scripts/ainra-live.sh runs one): hosted traders get real passports,
# verified at the real time, revocable from the Traders page. Needs the anchors above to be the ones accrediting it.
AINRA_REGISTRAR_URL=
AINRA_REGISTRAR_TOKEN=
# This service's own audience, for AINRA instance credentials (running copies of an agent).
# Empty = accept no instance credentials (AINRA's fail-closed default).
AINRA_AUDIENCE=

# The shared market's clock: calendar (follows the date; nobody can jump it ahead; the default on Vercel), demo
# (follows the date, and investors may also jump it ahead; the default elsewhere) or manual (moves only by hand).
MYLIQUID_MARKET_CLOCK=
# Prices: real (index funds follow VT/SPY/BNDW, bitcoin is the real price, as of the previous close; the default on
# Vercel) or simulated (the default elsewhere). Strategies and private assets are always simulated.
MYLIQUID_PRICES=
# Guest accounts all visitors together may open an hour (default 500; one visitor may open 10).
MYLIQUID_GUESTS_PER_HOUR=

# Keys the tamper-evident Activity log (HMAC-SHA256): 16+ random characters. Keep it out of the database's reach.
MYLIQUID_EVIDENCE_KEY=

# The founder dashboard at /admin (analytics, research answers, experiments): 16+ random characters. Unset = no /admin.
MYLIQUID_ADMIN_TOKEN=

# Protects the daily hosted-traders job (vercel.json crons). Vercel sends it automatically when set.
CRON_SECRET=

# The Android app (android/, docs/MOBILE.md): its signing key's SHA-256 fingerprint(s), comma-separated, served at
# /.well-known/assetlinks.json so the app opens full screen. The package name defaults to com.myliquid.app.
ANDROID_CERT_FINGERPRINTS=
ANDROID_PACKAGE_NAME=
